// Tooling that runs in Node: configs and the Playwright tests. The DOM lib
// inherited from tsconfig.json covers the tests' `page.evaluate` callbacks.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "allowJs": true
  },
  "include": ["*.config.ts", "*.config.js", "e2e"]
}
