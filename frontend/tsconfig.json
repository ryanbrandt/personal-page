{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // Check our own code, not third-party .d.ts files that churn between releases.
    "skipLibCheck": true,
    "paths": {
      "@app/*": ["./src/*"],
      "@styles/*": ["./src/styles/*"]
    }
  },
  "include": ["src"]
}
